#!/usr/bin/env python3
"""
Test the basic backend setup.
"""

import sys
import os
sys.path.insert(0, 'src')

# Set environment variable to avoid .env conflicts
os.environ['PYTHONPATH'] = 'src:' + os.environ.get('PYTHONPATH', '')

def test_imports():
    """Test that all main components can be imported."""
    print("Testing imports...")
    
    try:
        from main import app
        print("✓ FastAPI app imported successfully")
    except Exception as e:
        print(f"✗ Failed to import FastAPI app: {e}")
        return False
    
    try:
        from config.settings import get_settings
        print("✓ Settings module imported successfully")
    except Exception as e:
        print(f"✗ Failed to import settings: {e}")
        return False
    
    try:
        from db.session import db
        print("✓ Database session imported successfully")
    except Exception as e:
        print(f"✗ Failed to import database session: {e}")
        return False
    
    try:
        from security.auth import security
        print("✓ Security module imported successfully")
    except Exception as e:
        print(f"✗ Failed to import security module: {e}")
        return False
    
    try:
        from db.models import User, Plan, Task, Report, Chat
        print("✓ Database models imported successfully")
    except Exception as e:
        print(f"✗ Failed to import database models: {e}")
        return False
    
    return True

def test_app_structure():
    """Test the FastAPI app structure."""
    print("\nTesting app structure...")
    
    try:
        from main import app
        
        # Check basic app properties
        assert app.title == "StudyLoop API"
        print("✓ App title is correct")
        
        assert app.version == "0.1.0"
        print("✓ App version is correct")
        
        # Check routes exist
        route_paths = [route.path for route in app.routes]
        print(f"✓ Found {len(route_paths)} routes")
        
        # Check for auth routes
        auth_routes = [r for r in app.routes if r.tags and "Authentication" in r.tags]
        assert len(auth_routes) > 0, "No authentication routes found"
        print("✓ Authentication routes present")
        
        return True
        
    except Exception as e:
        print(f"✗ App structure test failed: {e}")
        return False

def test_security():
    """Test security utilities."""
    print("\nTesting security utilities...")
    
    try:
        from security.auth import SecurityUtils
        
        security = SecurityUtils()
        
        # Test password hashing
        password = "testpassword123"
        hash_result = security.hash_password(password)
        assert security.verify_password(password, hash_result), "Password verification failed"
        print("✓ Password hashing and verification works")
        
        # Test token creation
        token = security.create_access_token({"sub": "testuser"})
        assert isinstance(token, str), "Token should be a string"
        print("✓ Token creation works")
        
        return True
        
    except Exception as e:
        print(f"✗ Security test failed: {e}")
        return False

if __name__ == "__main__":
    print("=" * 50)
    print("StudyLoop Backend Phase 1 - Foundation Tests")
    print("=" * 50)
    
    all_tests_passed = True
    
    if not test_imports():
        all_tests_passed = False
    
    if not test_app_structure():
        all_tests_passed = False
    
    if not test_security():
        all_tests_passed = False
    
    print("\n" + "=" * 50)
    if all_tests_passed:
        print("SUCCESS: All Phase 1 foundation tests passed!")
    else:
        print("FAILURE: Some tests failed")
    print("=" * 50)