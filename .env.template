# Single shared configuration for StudyLoop.
# Copy this file to .env and fill in your values. Both the backend
# (backend/src/config/settings.py) and the frontend (frontend/vite.config.js
# with envDir set to the repo root) read this file.

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite:///./studyloop.db

# Security
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Integration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Frontend
# Vite exposes only VITE_-prefixed vars to the browser.
VITE_API_URL=http://127.0.0.1:8000